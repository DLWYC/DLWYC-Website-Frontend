# Copy to .env and fill in.
# SCAN_MODE = "toggle" posts to the backend API to check-in/out.
# SCAN_MODE = "console" just prints UIDs (for testing the wiring).
SCAN_MODE=toggle

# Your backend base URL.
# - Same machine as the backend: http://localhost:4000
# - Raspberry Pi on the same network as the Windows laptop running the
#   backend: http://<WINDOWS-LAPTOP-LAN-IP>:4000
#   (The backend prints its LAN IP on startup, e.g. http://192.168.1.20:4000.)
# - Or point at your hosted backend (the same one the frontend uses).
BACKEND_URL=http://localhost:4000

# The event to check people into/out of. Leave blank to let the backend decide.
EVENT_TITLE=2025 YOUTH CAMP

# Cooldown between accepted scans (ms). Prevents double-triggers.
SCAN_COOLDOWN_MS=1200
