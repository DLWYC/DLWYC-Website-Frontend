# DLWYC frontend environment variables.
#
# Leave VITE_BACKEND_URL EMPTY to use the local backend bundled in this repo
# (the Vite dev server proxies /api/* to the backend on port 4000 via
# `npm run dev:full`). Point it at a hosted backend when you have one.
VITE_BACKEND_URL=

# For production builds, set these (used across the app):
VITE_BASE_URL=https://dlwyc.example.org

# NOTE: payment provider keys (Paystack etc.) are SERVER secrets — they
# belong in the BACKEND's environment, never as VITE_* frontend variables
# (VITE_* values are bundled into the client and are public).
